# ─── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── MongoDB Atlas ────────────────────────────────────────────────────────
# Replace <user>, <password>, and the cluster host. Database name = financial_planning
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/financial_planning?retryWrites=true&w=majority&appName=Cluster0

# ─── JWT ──────────────────────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_hex_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=token

# ─── External APIs (used by Module 5 later, placeholders for now) ─────────
FINNHUB_API_KEY=
COINGECKO_API_KEY=
